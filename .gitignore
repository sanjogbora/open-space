node_modules/
dist/
.vite/
.turbo/
.env
.env.*
!.env.example
coverage/
artifacts/
*.log
apps/viewer-demo/public/published/

# Large binary scene files — never commit GLBs or uploaded source models
*.glb
*.gltf
apps/*/public/scenes/*/source/
# Runtime job-status files (regenerated on every conversion/bake/optimize run)
apps/*/public/scenes/*/conversion-job.json
apps/*/public/scenes/*/lightmap-bake-job.json
apps/*/public/scenes/*/optimization-job.json
apps/*/public/scenes/*/optimization-history.json
apps/*/public/scenes/*/.convert-model.py
apps/*/public/scenes/*/.convert-model-config.json

# Local tooling caches and agent logs
.pnpm-store/
.codex-logs/
.codex-dev-logs/
.dev-logs/
